# ── Atenção ──────────────────────────────────────────

# ── Ao gerar um novo .env verifique os preenchimentos abaixo para adequar ao novo ambiente.

# ── PostgreSQL ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=busqueaqui
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_POOL_MAX=20

# ── Servidor ─────────────────────────────────────────────
PORT=3000

# ── Segurança ────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria

# ── Admin padrão (criado automaticamente ao iniciar) ─────
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# ── CORS (lista de origens permitidas, separadas por vírgula) Retire o comentário abaixo para .env.prod ──
#CORS_ORIGIN=http://localhost:8080

# ── CORS (permissivo em dev) ────
# Deixar vazio ou '*' — o código usa '*' automaticamente no DEV Retire o comentário abaixo para .env.dev
#CORS_ORIGIN=*
