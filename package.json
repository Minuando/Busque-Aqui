{
  "name": "busque_aqui",
  "version": "2.0.0",
  "description": "Mapa interativo multiambiente — Node.js + PostgreSQL + Leaflet",
  "main": "server.js",
  "scripts": {
    "start":           "node server.js",

    "dev":             "node server.js --env=dev",
    "prod":            "node server.js --env=prod",
    "dev:watch":       "nodemon server.js -- --env=dev",
    "prod:watch":      "nodemon server.js -- --env=prod",

    "all":             "node start-all.js",
    "all:watch":       "node start-all.js --watch",
    "all:dev":         "node start-all.js dev",
    "all:prod":        "node start-all.js prod",

    "setup:dev":       "node scripts/setup-db.js --env=dev",
    "setup:prod":      "node scripts/setup-db.js --env=prod",
    "setup:dev:fresh": "node scripts/setup-db.js --env=dev --no-seed",

    "check:dev":       "node scripts/check-db.js --env=dev",
    "check:prod":      "node scripts/check-db.js --env=prod",

    "reset:dev":       "node scripts/teardown-db.js --env=dev --force",
    "reset:dev:ask":   "node scripts/teardown-db.js --env=dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
